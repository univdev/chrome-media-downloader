{
  "manifest_version": 3,
  "name": "Media Downloader",
  "version": "0.9.0",
  "description": "Download media from websites",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": [
    "storage",
    "downloads",
    "scripting",
    "activeTab",
    "background"
  ],
  "icons": {
    "16": "favicon-16x16.png",
    "32": "favicon-32x32.png",
    "192": "favicon-192x192.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
